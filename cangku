  }
  .hint{
    font-size:13px;
    color:var(--ink-soft);
    margin:6px 0 0;
  }
  input[type="file"]{
    font-size:14px;
  }
  input[type="password"], input[type="text"]{
    width:100%;
    padding:10px 12px;
    border:1px solid var(--line);
    border-radius:6px;
    font-size:14px;
    font-family:var(--mono);
    background:var(--paper);
  }
  .row{
    display:flex;
    gap:10px;
    align-items:center;
    flex-wrap:wrap;
  }
  .checkbox-line{
    display:flex;
    align-items:center;
    gap:6px;
    font-size:13px;
    color:var(--ink-soft);
    margin-top:8px;
  }
  button{
    font-family:inherit;
    font-size:14px;
    font-weight:600;
    border:none;
    border-radius:6px;
    padding:11px 20px;
    cursor:pointer;
    transition:opacity .15s;
  }
  button:disabled{ opacity:.45; cursor:not-allowed; }
  .btn-primary{
    background:var(--accent);
    color:#fff;
  }
  .btn-primary:hover:not(:disabled){ opacity:.88; }
  .btn-ghost{
    background:var(--accent-soft);
    color:var(--accent);
  }
  #parseStatus, #genStatus{
    font-size:13px;
    margin-top:10px;
    color:var(--ink-soft);
  }
  #parseStatus.ok, #genStatus.ok{ color:var(--accent); }
  #parseStatus.err, #genStatus.err{ color:var(--warn); }
  #preview{
    margin-top:14px;
    font-size:13px;
    color:var(--ink-soft);
    border-top:1px dashed var(--line);
    padding-top:12px;
    display:none;
  }
  #preview.show{ display:block; }
  #preview table{
    width:100%;
    border-collapse:collapse;
    font-size:12.5px;
  }
  #preview th, #preview td{
    text-align:left;
    padding:5px 8px;
    border-bottom:1px solid var(--line);
    vertical-align:top;
  }
  #preview th{ color:var(--ink); font-weight:600; }

  #outputCard{ display:none; }
  #outputCard.show{ display:block; }
  #outputBody{
    white-space:pre-wrap;
    font-size:14.5px;
    line-height:1.75;
    background:var(--paper);
    border:1px solid var(--line);
    border-radius:8px;
    padding:18px 20px;
    max-height:60vh;
    overflow-y:auto;
  }
  #outputBody strong{ color:var(--accent); }
  .toolbar{
    display:flex;
    gap:10px;
    margin-top:14px;
    flex-wrap:wrap;
  }
  .spinner{
    display:inline-block;
    width:13px;height:13px;
    border:2px solid var(--accent-soft);
    border-top-color:var(--accent);
    border-radius:50%;
    animation:spin .7s linear infinite;
    margin-right:6px;
    vertical-align:-2px;
  }
  @keyframes spin{ to{ transform:rotate(360deg); } }
  footer{
    margin-top:36px;
    font-size:12px;
    color:var(--ink-soft);
    border-top:1px solid var(--line);
    padding-top:16px;
  }
</style>
</head>
<body>
<div class="wrap">

  <header>
    <div class="eyebrow">Daily Report Digest</div>
    <h1>部门日报汇总</h1>
    <p>上传企业微信/Worktile导出的日报或周报表格，自动整理成一份带主题分类的部门汇总</p>
  </header>

  <div class="step">
    <div class="step-head"><span class="step-num">1</span><h2>填入密钥</h2></div>
    <input type="password" id="apiKey" placeholder="OpenRouter API Key（openrouter.ai 获取，用于生成汇总）">
    <div class="checkbox-line">
      <input type="checkbox" id="rememberKey">
      <label for="rememberKey">记住OpenRouter Key（仅保存在本机浏览器）</label>
    </div>
    <div style="height:10px"></div>
    <input type="password" id="scKey" placeholder="Server酱 SendKey（sct.ftqq.com 获取，用于推送到微信，选填）">
    <div class="checkbox-line">
      <input type="checkbox" id="rememberSc">
      <label for="rememberSc">记住Server酱 Key（仅保存在本机浏览器）</label>
    </div>
  </div>

  <div class="step">
    <div class="step-head"><span class="step-num">2</span><h2>上传日报/周报表格</h2></div>
    <div class="row" style="margin-bottom:12px;">
      <button class="btn-ghost" id="modeFileBtn" style="opacity:1;">上传Excel（电脑）</button>
      <button class="btn-ghost" id="modePasteBtn" style="opacity:.55;">粘贴文本（手机）</button>
    </div>

    <div id="fileMode">
      <input type="file" id="fileInput" accept=".xlsx,.xls,.csv" multiple>
      <p class="hint">可以一次选多个文件（比如日报+周报一起上传）。工具会自动识别"姓名"列，并把其余内容列（工作情况/待解决问题/知识积累/下周计划等）自动合并，忽略提交时间、评审人等非内容字段</p>
    </div>

    <div id="pasteMode" style="display:none;">
      <p class="hint" style="margin-top:0;">手机上没法方便地导出Excel时用这个。按下面格式粘贴，<b>每人一段，姓名单独一行，空一行分隔不同的人</b>：</p>
      <p class="hint" style="font-family:var(--mono); background:var(--paper); padding:8px 10px; border-radius:6px; border:1px solid var(--line);">王旭东<br>今日话务量38，接听来电27通……<br><br>姜芳芳<br>今日通话量45，邮件数据整理……</p>
      <textarea id="pasteInput" rows="10" style="width:100%; padding:10px 12px; border:1px solid var(--line); border-radius:6px; font-size:14px; font-family:inherit;" placeholder="从Worktile里复制内容后粘贴到这里"></textarea>
      <button class="btn-primary" id="parsePasteBtn" style="margin-top:10px;">解析文本</button>
    </div>

    <div id="parseStatus"></div>
    <div id="preview"></div>
  </div>

  <div class="step">
    <div class="step-head"><span class="step-num">3</span><h2>生成部门日报</h2></div>
    <button class="btn-primary" id="genBtn" disabled>生成部门日报</button>
    <div id="genStatus"></div>
  </div>

  <div class="step" id="outputCard">
    <div class="step-head"><span class="step-num">✓</span><h2>部门日报</h2></div>
    <div id="outputBody"></div>
    <div class="toolbar">
      <button class="btn-ghost" id="copyBtn">复制全文</button>
      <button class="btn-primary" id="pushBtn">推送到微信</button>
    </div>
    <div id="pushStatus" style="font-size:13px;margin-top:8px;color:var(--ink-soft);"></div>
  </div>

  <div class="step">
    <div class="step-head"><span class="step-num">4</span><h2>项目进展跟踪（跨设备，存在GitHub）</h2></div>

    <p class="hint" style="margin-top:0;">首次使用需要填一次GitHub信息，之后每台设备都填一次即可，数据本身存在GitHub上，不占用本机存储</p>
    <div class="row" style="margin-bottom:8px;">
      <input type="text" id="ghOwner" placeholder="GitHub用户名，如 huihuisun389-ux" style="flex:1;">
      <input type="text" id="ghRepo" placeholder="仓库名，如 moxihuihui" style="flex:1;">
    </div>
    <input type="password" id="ghToken" placeholder="GitHub Personal Access Token">
    <div class="checkbox-line">
      <input type="checkbox" id="rememberGh">
      <label for="rememberGh">记住这些信息（仅保存在本机浏览器，换设备需要重新填）</label>
    </div>

    <p class="hint">项目名单（用逗号分隔，AI遇到不在名单里的内容会建议新增，你确认后才会真正加入）：</p>
    <input type="text" id="projectList" placeholder="例如：知识库建设,周报工具迭代,客诉专项治理">

    <div class="toolbar">
      <button class="btn-primary" id="classifyBtn">归类到项目并保存进展</button>
      <button class="btn-ghost" id="viewProjectsBtn">查看项目进展时间线</button>
    </div>
    <div id="projectStatus" style="font-size:13px;margin-top:10px;color:var(--ink-soft);"></div>
    <div id="projectReview" style="display:none; margin-top:14px;">
      <div style="white-space:pre-wrap; font-size:14px; line-height:1.7; background:var(--paper); border:1px solid var(--line); border-radius:8px; padding:16px 18px;" id="projectReviewBody"></div>
      <div class="toolbar">
        <button class="btn-primary" id="confirmSaveBtn">确认无误，保存到GitHub</button>
      </div>
    </div>
    <div id="projectTimeline" style="display:none; margin-top:14px; white-space:pre-wrap; font-size:14px; line-height:1.75; background:var(--paper); border:1px solid var(--line); border-radius:8px; padding:16px 18px; max-height:60vh; overflow-y:auto;"></div>
  </div>

  <footer>
    表格和汇报内容只在你的浏览器、OpenRouter接口、Server酱推送接口之间传输，不会经过任何第三方服务器保存。刷新页面后已上传的数据会清空。
  </footer>

</div>

<script>
let parsedEntries = []; // [{name, content, period, sheet}]

const apiKeyInput = document.getElementById('apiKey');
const rememberKey = document.getElementById('rememberKey');
const savedKey = localStorage.getItem('openrouter_api_key_dept');
if (savedKey) { apiKeyInput.value = savedKey; rememberKey.checked = true; }
apiKeyInput.addEventListener('input', syncKeyStorage);
rememberKey.addEventListener('change', syncKeyStorage);
function syncKeyStorage(){
  if (rememberKey.checked && apiKeyInput.value.trim()) {
    localStorage.setItem('openrouter_api_key_dept', apiKeyInput.value.trim());
  } else {
    localStorage.removeItem('openrouter_api_key_dept');
  }
}

const scKeyInput = document.getElementById('scKey');
const rememberSc = document.getElementById('rememberSc');
const savedScKey = localStorage.getItem('serverchan_key_dept');
if (savedScKey) { scKeyInput.value = savedScKey; rememberSc.checked = true; }
scKeyInput.addEventListener('input', syncScStorage);
rememberSc.addEventListener('change', syncScStorage);
function syncScStorage(){
  if (rememberSc.checked && scKeyInput.value.trim()) {
    localStorage.setItem('serverchan_key_dept', scKeyInput.value.trim());
  } else {
    localStorage.removeItem('serverchan_key_dept');
  }
}

const fileInput = document.getElementById('fileInput');
const parseStatus = document.getElementById('parseStatus');
const preview = document.getElementById('preview');
const genBtn = document.getElementById('genBtn');
const genStatus = document.getElementById('genStatus');
const outputCard = document.getElementById('outputCard');
const outputBody = document.getElementById('outputBody');
const copyBtn = document.getElementById('copyBtn');

const modeFileBtn = document.getElementById('modeFileBtn');
const modePasteBtn = document.getElementById('modePasteBtn');
const fileMode = document.getElementById('fileMode');
const pasteMode = document.getElementById('pasteMode');
const pasteInput = document.getElementById('pasteInput');
const parsePasteBtn = document.getElementById('parsePasteBtn');

modeFileBtn.addEventListener('click', () => {
  fileMode.style.display = ''; pasteMode.style.display = 'none';
  modeFileBtn.style.opacity = '1'; modePasteBtn.style.opacity = '.55';
});
modePasteBtn.addEventListener('click', () => {
  fileMode.style.display = 'none'; pasteMode.style.display = '';
  modeFileBtn.style.opacity = '.55'; modePasteBtn.style.opacity = '1';
});

parsePasteBtn.addEventListener('click', () => {
  const raw = pasteInput.value.trim();
  parseStatus.className = '';
  preview.classList.remove('show');
  genBtn.disabled = true;
  if (!raw) {
    parseStatus.className = 'err';
    parseStatus.textContent = '请先粘贴内容';
    return;
  }
  // 按空行分块，每块第一行当姓名（要求短，不超过8个字，不含标点），其余当内容
  const blocks = raw.split(/\n\s*\n/).map(b => b.trim()).filter(Boolean);
  const entries = [];
  const skipped = [];
  blocks.forEach(block => {
    const lines = block.split('\n').map(l => l.trim()).filter(Boolean);
    if (!lines.length) return;
    const first = lines[0];
    const isLikelyName = first.length <= 8 && !/[，。：:！？、\d]/.test(first);
    if (!isLikelyName || lines.length < 2) {
      skipped.push(block.slice(0, 20));
      return;
    }
    entries.push({
      name: first,
      content: lines.slice(1).join('\n'),
      pending: '',
      period: '',
      sheet: '粘贴文本'
    });
  });

  if (!entries.length) {
    parseStatus.className = 'err';
    parseStatus.textContent = '没能识别出任何一段——请检查格式：第一行是姓名（短，不含标点），第二行开始是内容，不同人之间空一行';
    return;
  }

  parsedEntries = entries;
  parseStatus.className = 'ok';
  parseStatus.textContent = `解析成功：共识别到 ${entries.length} 人` + (skipped.length ? `，有 ${skipped.length} 段没能识别为"姓名+内容"格式，已跳过` : '');

  preview.innerHTML = '<table><thead><tr><th>姓名</th><th>周期/来源</th><th>内容预览</th></tr></thead><tbody>' +
    parsedEntries.map(en => `<tr><td>${escapeHtml(en.name)}</td><td>${escapeHtml(en.period || en.sheet)}</td><td>${escapeHtml(en.content.slice(0,50))}${en.content.length>50?'…':''}</td></tr>`).join('') +
    '</tbody></table>';
  preview.classList.add('show');
  genBtn.disabled = false;
});

const NAME_KEYS = ['姓名','工号','员工','客服','填报人','提交人'];
// 这些列视为"非内容"字段，其余列一律当作汇报内容自动合并
const META_KEYS = ['简报周期','提交时间','评审人','可见成员','评审状态','附件','周期'];

fileInput.addEventListener('change', handleFiles);

function readFileAsWorkbook(file){
  return new Promise((resolve, reject) => {
    const reader = new FileReader();
    reader.onload = evt => {
      try {
        const data = new Uint8Array(evt.target.result);
        resolve(XLSX.read(data, { type:'array' }));
      } catch (err) { reject(err); }
    };
    reader.onerror = () => reject(new Error('文件读取失败'));
    reader.readAsArrayBuffer(file);
  });
}

async function handleFiles(e){
  const files = Array.from(e.target.files || []);
  if (!files.length) return;
  parseStatus.className = '';
  parseStatus.textContent = '正在解析…';
  preview.classList.remove('show');
  genBtn.disabled = true;
  parsedEntries = [];

  const notes = [];
  try {
    for (const file of files) {
      const wb = await readFileAsWorkbook(file);
      for (const sheetName of wb.SheetNames) {
        const sheet = wb.Sheets[sheetName];
        const rows = XLSX.utils.sheet_to_json(sheet, { defval:'' });
        if (!rows.length) continue;

        const headers = Object.keys(rows[0]);
        const nameCol = headers.find(h => NAME_KEYS.some(k => h.includes(k)));
        if (!nameCol) {
          notes.push(`工作表"${sheetName}"没能识别出姓名列（表头：${headers.join('、')}），已跳过`);
          continue;
        }
        const periodCol = headers.find(h => h.includes('周期'));
        const pendingCol = headers.find(h => h.includes('待解决'));
        const contentCols = headers.filter(h =>
          h !== nameCol && h !== periodCol && !META_KEYS.some(m => h.includes(m))
        );

        rows.forEach(r => {
          const name = String(r[nameCol] ?? '').trim();
          if (!name) return;
          const content = contentCols
            .map(c => {
              const v = String(r[c] ?? '').trim();
              return v ? `【${c}】${v}` : '';
            })
            .filter(Boolean)
            .join('\n');
          if (!content) return; // 未提交/空行，跳过
          parsedEntries.push({
            name,
            content,
            pending: pendingCol ? String(r[pendingCol] ?? '').trim() : '',
            period: periodCol ? String(r[periodCol] ?? '').trim() : '',
            sheet: sheetName
          });
        });
      }
    }

    if (!parsedEntries.length) {
      throw new Error('没有解析到有效的汇报内容。' + (notes.length ? notes.join('；') : '请检查文件格式是否正确。'));
    }

    parseStatus.className = 'ok';
    parseStatus.textContent = `解析成功：共读到 ${parsedEntries.length} 条汇报（来自 ${files.length} 个文件）` + (notes.length ? '。注意：' + notes.join('；') : '');

    preview.innerHTML = '<table><thead><tr><th>姓名</th><th>周期/来源</th><th>内容预览</th></tr></thead><tbody>' +
      parsedEntries.map(en => `<tr><td>${escapeHtml(en.name)}</td><td>${escapeHtml(en.period || en.sheet)}</td><td>${escapeHtml(en.content.slice(0,50))}${en.content.length>50?'…':''}</td></tr>`).join('') +
      '</tbody></table>';
    preview.classList.add('show');

    genBtn.disabled = false;
  } catch (err) {
    parseStatus.className = 'err';
    parseStatus.textContent = '解析失败：' + err.message;
  }
}

function escapeHtml(s){
  return s.replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
}

genBtn.addEventListener('click', generateDigest);

async function generateDigest(){
  const key = apiKeyInput.value.trim();
  if (!key) {
    genStatus.className = 'err';
    genStatus.textContent = '请先填入OpenRouter API Key';
    return;
  }
  genBtn.disabled = true;
  genStatus.className = '';
  genStatus.innerHTML = '<span class="spinner"></span>正在生成，通常需要10-30秒…';
  outputCard.classList.remove('show');

  const today = new Date().toLocaleDateString('zh-CN', { year:'numeric', month:'2-digit', day:'2-digit' });
  const reportsText = parsedEntries
    .map(en => `【${en.name}】（${en.period || en.sheet}）\n${en.content}`)
    .join('\n\n');

  const prompt = `你是客服团队主管的助理，请把下面团队成员各自提交的汇报（可能包含日报和周报），整理成一份部门汇总，要求：

1. 先给出"部门概览"：按事项/主题归类（比如共性问题处理、系统或工具问题、培训与知识库建设、绩效或客诉相关等），把做了类似事情的同事放在一起说明，指出重复出现的问题或值得关注的共性趋势
2. 再给出"个人明细"：逐人列出姓名、对应的汇报周期，以及工作要点（可适当精简、去除口语化表达，但不要遗漏具体信息、数字和事项）
3. 客观陈述，不要夸大总结，也不要编造原始内容里没有的信息
4. 格式适合微信阅读，使用**加粗**标出小标题，分段清晰
5. 不需要输出"待解决事项/待跟进事项"这个板块，后面会单独处理

今日整理日期：${today}

原始汇报（共${parsedEntries.length}条）：
${reportsText}`;

  try {
    const digest = await callAI(prompt);

    let pendingSection = '';
    const withPending = parsedEntries.filter(en => en.pending);
    if (withPending.length) {
      genStatus.innerHTML = '<span class="spinner"></span>正在整理待跟进事项…';
      const polished = [];
      for (const en of withPending) {
        try {
          const p = await callAI(
            `请把下面这段"待解决问题"精炼压缩成一两句话，保留关键信息（涉及事项、对象、工单等），不要新增或臆测原文没有的内容，不要加姓名、不要加称呼，直接给出精炼后的文字：\n\n${en.pending}`
          );
          polished.push(`- **${en.name}**：${p.trim()}`);
        } catch (e) {
          // 单条精炼失败就退回用原文，不影响整体
          polished.push(`- **${en.name}**：${en.pending}`);
        }
      }
      pendingSection = '\n\n**待跟进事项**\n' + polished.join('\n');
    }

    const finalText = digest + pendingSection;
    outputBody.innerHTML = escapeHtml(finalText).replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>');
    outputCard.classList.add('show');
    genStatus.className = 'ok';
    genStatus.textContent = '生成完成';
  } catch (err) {
    genStatus.className = 'err';
    genStatus.textContent = '生成失败：' + err.message;
  } finally {
    genBtn.disabled = false;
  }
}

async function callAI(userPrompt){
  const key = apiKeyInput.value.trim();
  const resp = await fetch('https://openrouter.ai/api/v1/chat/completions', {
    method:'POST',
    headers:{
      'Authorization': 'Bearer ' + key,
      'Content-Type': 'application/json',
      'HTTP-Referer': 'https://claude.ai',
      'X-Title': 'Department Report Digest'
    },
    body: JSON.stringify({
      model:'google/gemini-2.5-flash-lite',
      messages:[{ role:'user', content: userPrompt }],
      temperature:0.3
    })
  });
  if (!resp.ok) {
    const errText = await resp.text();
    throw new Error(`接口返回错误（状态码${resp.status}）：${errText.slice(0,200)}`);
  }
  const data = await resp.json();
  const text = data.choices?.[0]?.message?.content;
  if (!text) throw new Error('接口返回内容为空，请稍后重试');
  return text;
}

