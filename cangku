    margin-bottom:32px;
    border-bottom:2px solid var(--ink);
    padding-bottom:18px;
  }
  header .eyebrow{
    font-family:var(--mono);
    font-size:12px;
    letter-spacing:.12em;
    color:var(--accent);
    text-transform:uppercase;
  }
  header h1{
    font-size:26px;
    margin:6px 0 4px;
    letter-spacing:.01em;
  }
  header p{
    margin:0;
    color:var(--ink-soft);
    font-size:14px;
