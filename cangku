        .sort((a,b) => a.date.localeCompare(b.date))
        .forEach(e => { out += `${e.date}（${e.person}）：${e.summary}\n`; });
      out += '\n';
    });
    projectTimeline.style.display = '';
    projectTimeline.textContent = out.trim();
    projectStatus.textContent = '已加载最新项目进展';
    projectStatus.style.color = 'var(--accent)';
  } catch (err) {
    projectStatus.style.color = 'var(--warn)';
    projectStatus.textContent = '读取失败：' + err.message;
  } finally {
    viewProjectsBtn.disabled = false;
  }
});
