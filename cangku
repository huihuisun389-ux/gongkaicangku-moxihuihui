const GH_FILE_PATH = 'projects.json';
let pendingClassification = null; // {entries, newProjects}

(function loadGhSaved(){
  const saved = localStorage.getItem('gh_config_dept');
  if (saved) {
    try {
      const c = JSON.parse(saved);
      ghOwner.value = c.owner || '';
      ghRepo.value = c.repo || '';
      ghToken.value = c.token || '';
      projectListInput.value = c.projectList || '';
      rememberGh.checked = true;
    } catch(e){}
  }
})();
[ghOwner, ghRepo, ghToken, projectListInput].forEach(el => el.addEventListener('input', syncGhStorage));
rememberGh.addEventListener('change', syncGhStorage);
function syncGhStorage(){
  if (rememberGh.checked) {
    localStorage.setItem('gh_config_dept', JSON.stringify({
      owner: ghOwner.value.trim(), repo: ghRepo.value.trim(),
      token: ghToken.value.trim(), projectList: projectListInput.value.trim()
    }));
  } else {
    localStorage.removeItem('gh_config_dept');
  }
}

function ghHeaders(){
  return {
    'Authorization': 'token ' + ghToken.value.trim(),
    'Accept': 'application/vnd.github+json'
  };
}
function ghUrl(){
  return `https://api.github.com/repos/${ghOwner.value.trim()}/${ghRepo.value.trim()}/contents/${GH_FILE_PATH}`;
}
function b64EncodeUnicode(str){
  return btoa(unescape(encodeURIComponent(str)));
}
function b64DecodeUnicode(str){
  return decodeURIComponent(escape(atob(str)));
}

// 读取 GitHub 上的 projects.json；文件不存在时返回空结构（sha为null）
async function readProjectsFile(){
  const resp = await fetch(ghUrl(), { headers: ghHeaders() });
  if (resp.status === 404) {
    return { data: { projects: [], entries: [] }, sha: null };
  }
  if (!resp.ok) throw new Error(`读取GitHub文件失败（状态码${resp.status}），检查用户名/仓库名/Token是否正确`);
  const json = await resp.json();
  const content = b64DecodeUnicode(json.content.replace(/\n/g, ''));
  let data;
  try { data = JSON.parse(content); } catch(e) { data = { projects: [], entries: [] }; }
  if (!data.projects) data.projects = [];
  if (!data.entries) data.entries = [];
  return { data, sha: json.sha };
}

async function writeProjectsFile(data, sha, message){
  const resp = await fetch(ghUrl(), {
    method: 'PUT',
    headers: { ...ghHeaders(), 'Content-Type': 'application/json' },
    body: JSON.stringify({
      message: message || '更新项目进展',
      content: b64EncodeUnicode(JSON.stringify(data, null, 2)),
      sha: sha || undefined
    })
  });
  if (!resp.ok) {
    const t = await resp.text();
    throw new Error(`保存到GitHub失败（状态码${resp.status}）：${t.slice(0,200)}`);
  }
  return resp.json();
}

classifyBtn.addEventListener('click', async () => {
  if (!ghOwner.value.trim() || !ghRepo.value.trim() || !ghToken.value.trim()) {
    projectStatus.style.color = 'var(--warn)';
    projectStatus.textContent = '请先填GitHub用户名、仓库名和Token';
    return;
  }
  if (!parsedEntries.length) {
    projectStatus.style.color = 'var(--warn)';
    projectStatus.textContent = '请先在第2步上传/粘贴并解析出汇报内容';
    return;
  }
  classifyBtn.disabled = true;
  projectReview.style.display = 'none';
  projectStatus.style.color = 'var(--ink-soft)';
  projectStatus.innerHTML = '<span class="spinner"></span>正在读取现有项目数据…';

  try {
    const { data: existing } = await readProjectsFile();
    const knownProjects = Array.from(new Set([
      ...(projectListInput.value.split(',').map(s => s.trim()).filter(Boolean)),
      ...existing.projects
    ]));

    projectStatus.innerHTML = '<span class="spinner"></span>正在用AI归类…';

    const today = new Date().toLocaleDateString('zh-CN', { year:'numeric', month:'2-digit', day:'2-digit' });
    const entriesText = parsedEntries.map((en,i) => `[${i}]【${en.name}】${en.content}`).join('\n\n');
    const classifyPrompt = `你是项目管理助理。已有项目名单：${knownProjects.length ? knownProjects.join('、') : '（暂无，需要你从内容里判断）'}

请阅读下面每一条汇报，判断它涉及名单里的哪个项目。如果内容明显不属于名单里任何一个项目，用"🆕项目名"的格式给出一个你认为合适的新项目名（简短，4-10个字）；如果一条内容不涉及任何具体项目（纯日常事务性内容），项目填"无归属"。

严格按下面的JSON数组格式输出，不要输出任何其他文字，不要用markdown代码块包裹：
[{"index":0,"project":"项目名或🆕新项目名或无归属","summary":"一句话进展描述，客观、不超过40字"}, ...]

今日日期：${today}

汇报内容：
${entriesText}`;

    const raw = await callAI(classifyPrompt);
    let cleaned = raw.trim().replace(/^```json\s*/i, '').replace(/^```\s*/,'').replace(/```\s*$/,'');
    let result;
    try { result = JSON.parse(cleaned); } catch(e) {
      throw new Error('AI返回格式无法解析，请重试一次');
    }

    const newProjects = new Set();
    result.forEach(r => {
      if (r.project && r.project.startsWith('🆕')) newProjects.add(r.project.replace('🆕','').trim());
    });

    pendingClassification = { existing, result, today };

    let reviewText = '';
    result.forEach(r => {
      const en = parsedEntries[r.index];
      reviewText += `【${en ? en.name : '?'}】→ ${r.project}\n${r.summary}\n\n`;
    });
    if (newProjects.size) {
      reviewText = `⚠️ 发现 ${newProjects.size} 个不在现有名单里的新项目：${Array.from(newProjects).join('、')}\n（确认保存后会自动加入项目名单）\n\n` + reviewText;
    }
    projectReviewBody.textContent = reviewText.trim();
    projectReview.style.display = '';
    projectStatus.style.color = 'var(--accent)';
    projectStatus.textContent = '归类完成，请检查下方结果，确认无误后点"保存到GitHub"';
  } catch (err) {
    projectStatus.style.color = 'var(--warn)';
    projectStatus.textContent = '归类失败：' + err.message;
  } finally {
    classifyBtn.disabled = false;
  }
});

confirmSaveBtn.addEventListener('click', async () => {
  if (!pendingClassification) return;
  confirmSaveBtn.disabled = true;
  projectStatus.style.color = 'var(--ink-soft)';
  projectStatus.innerHTML = '<span class="spinner"></span>正在保存到GitHub…';
  try {
    const { existing, result, today } = pendingClassification;
    const { sha } = await readProjectsFile(); // 重新拿一次最新sha，避免冲突

    const projectSet = new Set(existing.projects);
    result.forEach(r => {
      const projectName = r.project.startsWith('🆕') ? r.project.replace('🆕','').trim() : r.project;
      if (projectName && projectName !== '无归属') projectSet.add(projectName);
      const en = parsedEntries[r.index];
      existing.entries.push({
        date: today,
        project: projectName,
        person: en ? en.name : '',
        summary: r.summary
      });
    });
    existing.projects = Array.from(projectSet);

    await writeProjectsFile(existing, sha, `新增 ${today} 的项目进展记录`);
    projectStatus.style.color = 'var(--accent)';
    projectStatus.textContent = '已保存到GitHub';
    projectReview.style.display = 'none';
    pendingClassification = null;
  } catch (err) {
    projectStatus.style.color = 'var(--warn)';
    projectStatus.textContent = '保存失败：' + err.message;
  } finally {
    confirmSaveBtn.disabled = false;
  }
});

